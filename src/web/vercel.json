{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/desktop",
      "destination": "/desktop.html"
    },
    {
      "source": "/((?!assets/|icons/|api/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/market",
      "destination": "/exchange",
      "permanent": true
    },
    {
      "source": "/market/:path*",
      "destination": "/exchange/:path*",
      "permanent": true
    },
    {
      "source": "/media",
      "destination": "/bmusic",
      "permanent": true
    },
    {
      "source": "/media/:path*",
      "destination": "/bmusic/:path*",
      "permanent": true
    },
    {
      "source": "/tickets",
      "destination": "/wallet/tickets",
      "permanent": true
    },
    {
      "source": "/tickets/:path*",
      "destination": "/wallet/tickets/:path*",
      "permanent": true
    },
    {
      "source": "/credits",
      "destination": "/wallet/credits",
      "permanent": true
    },
    {
      "source": "/credits/:path*",
      "destination": "/wallet/credits/:path*",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/bchatx-feed",
      "permanent": true
    },
    {
      "source": "/feed/:path*",
      "destination": "/bchatx-feed/:path*",
      "permanent": true
    },
    {
      "source": "/bmusic/artist/:slug",
      "destination": "/bmusic/artists/:slug",
      "permanent": true
    }
  ]
}
