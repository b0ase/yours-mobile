# bWallet build settings (copy to .env.local)
# bCorp HandCash address receives mint + market fees; empty = no fee
BWALLET_MINT_FEE_ADDRESS=
BWALLET_MARKET_FEE_ADDRESS=
# "Set up $X's room" bCorp fee: USD price (default 1) paid in sats to this address; empty = no fee
BWALLET_ROOM_SETUP_FEE_USD=1
BWALLET_ROOM_SETUP_FEE_ADDRESS=
