# bwallet site (Vercel project "bwallet"). Set real values in Vercel env, never in git.
SUPABASE_URL=https://your-supabase-host
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Paymail: the domain in name@domain. Must be chosen before launch (needs HTTPS + /.well-known/bsvalias or SRV).
PAYMAIL_DOMAIN=bwallet-nine.vercel.app
# Optional: where capability URLs point if not https://$PAYMAIL_DOMAIN (e.g. SRV target host).
PAYMAIL_BASE_URL=
# Optional best-effort rebroadcast of received P2P txs.
ARC_URL=https://arc.gorillapool.io
ARC_API_KEY=
