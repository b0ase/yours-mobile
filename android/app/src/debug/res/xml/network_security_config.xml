<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the emulator reach test dApps served over plain
     http from the host machine (10.0.2.2). Release builds keep Android's
     default of HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
