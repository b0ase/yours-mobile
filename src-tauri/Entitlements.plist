<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (notarised builds): bWallet calls and Spaces use the mic and camera. Not sandboxed.
	     Do NOT add keychain-access-groups without an embedded provisioning profile: macOS refuses to launch the
	     app (see bchat-desktop/src-tauri/Entitlements.plist). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
