{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bWalletX",
  "version": "../package.json",
  "identifier": "com.bitcoincorp.bwalletx.desktop",
  "build": {
    "frontendDist": "../build-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "bWalletX",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss:",
        "frame-src": "'self' https:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "freezePrototype": false,
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bwalletx"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQzUxOEIyRDA0OTM3NTIKUldSU04wblFzaGpGWUJVV2FPS0pTUUxDaGJkaDJJU2xubmI0bDh0K1dOcCsrY3hVc1NGL1VWTGoK",
      "endpoints": ["https://bwalletx.com/download/desktop/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "bWalletX Desktop",
    "longDescription": "bWalletX, the BSV wallet for tokens, media and apps, on the desktop.",
    "copyright": "The Bitcoin Corporation Ltd. MIT licensed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
